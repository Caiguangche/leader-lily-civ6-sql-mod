<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="12.0" DefaultTargets="Default" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Default</Configuration>
    <Name>Ender Lilies: Lily</Name>
    <Guid>61109129-fdce-4b09-b484-4eaf3070aa22</Guid>
    <ProjectGuid>0983459c-4e24-4d97-8411-c83535e1a25e</ProjectGuid>
    <ModVersion>1</ModVersion>
    <Teaser>Leader Lily</Teaser>
    <Description>Add a new Civilization: Land's End.[newline]Add a new Leader: Lily.</Description>
    <Authors>海绵宝宝很黄、欧德王</Authors>
    <SpecialThanks>
    </SpecialThanks>
    <AffectsSavedGames>true</AffectsSavedGames>
    <SupportsSinglePlayer>true</SupportsSinglePlayer>
    <SupportsMultiplayer>true</SupportsMultiplayer>
    <SupportsHotSeat>true</SupportsHotSeat>
    <CompatibleVersions>1.2,2.0</CompatibleVersions>
    <ActionCriteriaData><![CDATA[<ActionCriteria><Criteria id="LeaderLilyCriteria">
      <LeaderPlayable>Players:StandardPlayers::LEADER_LILY,Players:Expansion1_Players::LEADER_LILY,Players:Expansion2_Players::LEADER_LILY</LeaderPlayable>
      </Criteria><Criteria id="LeaderLilyCriteria_Expansion1">
      <LeaderPlayable>Players:Expansion1_Players::LEADER_LILY</LeaderPlayable>
      <RuleSetInUse>RULESET_EXPANSION_1</RuleSetInUse>
      </Criteria><Criteria id="LeaderLilyCriteria_Expansion2">
      <LeaderPlayable>Players:Expansion2_Players::LEADER_LILY</LeaderPlayable>
      <RuleSetInUse>RULESET_EXPANSION_2</RuleSetInUse></Criteria>
      <Criteria id="LE_Babylon">
        <ModInUse>8424840C-92EF-4426-A9B4-B4E0CB818049</ModInUse>
        <RuleSetInUse>RULESET_STANDARD,RULESET_EXPANSION_1,RULESET_EXPANSION_2</RuleSetInUse>
      </Criteria>
      <Criteria id="LE_SecretSocieties_EXPANSION">
       <ConfigurationValueMatches>
        <Group>Game</Group>
        <ConfigurationId>GAMEMODE_SECRETSOCIETIES</ConfigurationId>
        <Value>1</Value>
       </ConfigurationValueMatches>
      </Criteria>
      </ActionCriteria>]]></ActionCriteriaData>
    <AssemblyName>LeaderLily</AssemblyName>
    <RootNamespace>LeaderLily</RootNamespace>
    <FrontEndActionData><![CDATA[<FrontEndActions><UpdateDatabase id="LE_Config"><File>Data/Land's_End_Config.xml</File></UpdateDatabase><UpdateIcons id="LE_Icons"><File>Data/Land's_End_Icon.xml</File></UpdateIcons><UpdateText id="LE_Text"><File>Text/Land's_End_CNS_Text.xml</File><File>Text/Land's_End_CNT_Text.xml</File><File>Text/Land's_End_EN_Text.xml</File><File>Text/Land's_End_JP_Text.xml</File></UpdateText><UpdateArt id="LE_Art"><File>(Mod Art Dependency File)</File></UpdateArt><UpdateColors id="LE_Colors"><File>Data/Land's_End_Color.xml</File></UpdateColors></FrontEndActions>]]></FrontEndActionData>
    <InGameActionData><![CDATA[<InGameActions><UpdateDatabase id="LE_Data"><File>Gameplay/SQL/01_civilization.sql</File><File>Gameplay/SQL/02_leader.sql</File><File>Gameplay/SQL/03_district.sql</File><File>Gameplay/SQL/04_unit.sql</File><File>Gameplay/SQL/05_building.sql</File><File>Gameplay/SQL/06_religion.sql</File></UpdateDatabase><UpdateIcons id="LE_Icons"><File>Data/Land's_End_Icon.xml</File></UpdateIcons><UpdateText id="LE_Text"><File>Text/Land's_End_CNS_Text.xml</File><File>Text/Land's_End_CNT_Text.xml</File><File>Text/Land's_End_EN_Text.xml</File><File>Text/Land's_End_JP_Text.xml</File></UpdateText><UpdateArt id="LE_Art"><File>(Mod Art Dependency File)</File></UpdateArt><UpdateColors id="LE_Colors"><File>Data/Land's_End_Color.xml</File></UpdateColors><UpdateDatabase id="LE_Babylon_Pack"><Criteria>LE_Babylon</Criteria><File>Gameplay/SQL/dlc/10_babylon_pack.sql</File></UpdateDatabase><UpdateDatabase id="LE_Expansion1"><Criteria>LeaderLilyCriteria_Expansion1</Criteria><File>Gameplay/SQL/dlc/11_expansion1.sql</File></UpdateDatabase><UpdateDatabase id="LE_Expansion2"><Criteria>LeaderLilyCriteria_Expansion2</Criteria><File>Gameplay/SQL/dlc/12_expansion2.sql</File></UpdateDatabase><UpdateDatabase id="LE_SecretSocieties"><Criteria>LE_SecretSocieties_EXPANSION</Criteria><File>Gameplay/SQL/dlc/13_secret_societies.sql</File></UpdateDatabase><UpdateAudio id="LE_Audio"><File>Platforms/Windows/Audio/LAND_S_END_Audio.ini</File></UpdateAudio></InGameActions>]]></InGameActionData>
