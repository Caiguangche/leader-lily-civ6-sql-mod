		<Row Tag="LOC_CIVILIZATION_LAND_S_END_NAME" Language="zh_Hans_CN">
			<Text>边陲之国</Text>
		</Row>
		<Row Tag="LOC_CIVILIZATION_LAND_S_END_DESCRIPTION" Language="zh_Hans_CN">
			<Text>边陲之国</Text>
